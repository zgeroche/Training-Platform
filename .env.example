# Copy this file to .env and fill in the values from https://developer-dashboard.whoop.com
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Must exactly match a redirect URL registered on your WHOOP app
WHOOP_REDIRECT_URI=http://localhost:8000/auth/whoop/callback

# SQLite file (folder is created automatically)
DATABASE_URL=sqlite:///data/training.db

# How often the background poller pulls new WHOOP data
SYNC_INTERVAL_MINUTES=20
# First sync: how many days of history to pull (0 = everything WHOOP has)
WHOOP_BACKFILL_DAYS=0
